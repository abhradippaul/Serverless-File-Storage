{
  "name": "Backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=bundle --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "file-storage-aws",
    "backend",
    "serverless",
    "aws",
    "typescript",
    "express",
    "cors",
    "dotenv",
    "pnpm",
    "tsx",
    "node"
  ],
  "author": "Abhradip Paul",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1177.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.3"
  }
}